msgid "Logging"
msgstr "Loggning"

#: includes/settings.php
msgid "Log Threshold Breaches"
msgstr "Överträdelser i loggränsen"

#: includes/settings.php
msgid "Enable logging of all Threshold failures to the Cacti Log."
msgstr "Aktivera loggning av alla tröskelfel i Cacti-loggen."

#: includes/settings.php
msgid "Show Data Source in Log"
msgstr "Visa datakälla i logg"

#: includes/settings.php
msgid "Show the Data Source name in the Log if not present."
msgstr "Visa datakällans namn i loggen om den inte är närvarande."

#: includes/settings.php
msgid "Log Threshold Changes"
msgstr "Ändringar av logggränserna"

#: includes/settings.php
msgid "Enable logging of all Threshold changes to the Cacti Log."
msgstr "Aktivera loggning av alla tröskeländringar till cacti-loggen."

#: includes/settings.php
msgid "Debug Log"
msgstr "Felsökningslogg"

#: includes/settings.php
msgid "Enable logging of debug messages with Threshold"
msgstr "Aktivera loggning av felsökningsmeddelanden med tröskelvärdet"

#: includes/settings.php
msgid "Alert Log Retention"
msgstr "Alert Log Retention"

#: includes/settings.php
msgid "Keep Threshold Logs for this number of days."
msgstr "Håll tröskelloggar för det här antalet dagar."

