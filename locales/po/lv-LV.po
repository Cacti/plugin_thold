#: thold_templates.php
msgid "This is a listing of accounts that will be notified when this Threshold is breached.<br><br><br><br>"
msgstr "Šis ir kontu saraksts, kuriem tiks nosūtīts paziņojums, kad šis slieksnis tiks pārkāpts.<br><br><br><br>"

