msgstr "Bhala Elogini Ukuphulwa Komkhawulo"

#: includes/settings.php
msgid "Enable logging of all Threshold failures to the Cacti Log."
msgstr "Nika amandla ukuloga kwakho konke ukwehluleka koMkhawulo kuLog ye-Cacti."

#: includes/settings.php
