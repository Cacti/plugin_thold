msgid "The number of daemon threads to be handled by the Threshold Daemon."
msgstr "Số lượng quy trình đồng thời tối đa được xử lý bởi Ngưỡng Daemon."

#: includes/settings.php
msgid "1 Process"
msgstr "1 quá trình"

