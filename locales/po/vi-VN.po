#: includes/functions.php
msgid "Impossible threshold: 'High Alert Threshold' smaller than the 'Low Alert Threshold'!"
msgstr "Ngưỡng không thể: 'Ngưỡng cao' nhỏ hơn hoặc bằng 'Ngưỡng thấp'!"

#: includes/functions.php
msgid "Impossible threshold: 'High Warning Threshold' smaller than the 'Low Warning Threshold'!"
msgstr "Ngưỡng không thể: 'Ngưỡng cảnh báo cao' nhỏ hơn hoặc bằng 'Ngưỡng cảnh báo thấp'!"

#: includes/functions.php
msgid "Impossible threshold: 'High Warning Threshold' larger than the 'High Alert Threshold'!"
msgstr "Ngưỡng không hợp lệ: 'Ngưỡng cảnh báo cao' lớn hơn 'Ngưỡng báo động cao'!"

#: includes/functions.php
msgid "Impossible threshold: 'Low Alert Threshold' larger than the 'Low Warning Threshold'!"
msgstr "Ngưỡng không hợp lệ: 'Ngưỡng báo động thấp' lớn hơn 'Ngưỡng cảnh báo thấp'!"

#: includes/functions.php
msgid "Time reference in the past must be set to positive integer value!"
msgstr "Tham chiếu thời gian trong quá khứ phải được đặt thành giá trị số nguyên dương!"

#: includes/functions.php
msgid "You must specify either 'Baseline Deviation UP' or 'Baseline Deviation DOWN' or both!"
