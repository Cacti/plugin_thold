msgid "Logging"
msgstr "Đăng nhập"

#: includes/settings.php
msgid "Log Threshold Breaches"
msgstr "Đăng nhập Ngưỡng vi phạm"

#: includes/settings.php
msgid "Enable logging of all Threshold failures to the Cacti Log."
msgstr "Cho phép ghi nhật ký tất cả các lỗi Ngưỡng vào Nhật ký Cacti."

#: includes/settings.php
msgid "Show Data Source in Log"
msgstr "Hiển thị nguồn dữ liệu trong nhật ký"

#: includes/settings.php
msgid "Show the Data Source name in the Log if not present."
msgstr "Hiển thị tên Nguồn dữ liệu trong Nhật ký nếu không có."

#: includes/settings.php
msgid "Log Threshold Changes"
msgstr "Thay đổi ngưỡng đăng nhập"

#: includes/settings.php
msgid "Enable logging of all Threshold changes to the Cacti Log."
msgstr "Cho phép ghi nhật ký tất cả các thay đổi Ngưỡng vào Nhật ký Cacti."

#: includes/settings.php
msgid "Debug Log"
msgstr "Nhật ký gỡ lỗi"

#: includes/settings.php
msgid "Enable logging of debug messages with Threshold"
msgstr "Cho phép ghi nhật ký các thông báo gỡ lỗi với Ngưỡng"

#: includes/settings.php
msgid "Alert Log Retention"
msgstr "Lưu giữ nhật ký thông báo"

#: includes/settings.php
msgid "Keep Threshold Logs for this number of days."
msgstr "Giữ Nhật ký Ngưỡng cho số ngày này."

#: includes/settings.php
msgid "Log action Consider Unknown Data as Zero"
msgstr "Coi dữ liệu không xác định là 0"

#: includes/settings.php
msgid "When 'Consider Unknown Data as Zero' is enabled, log when it occurs"
msgstr "Coi dữ liệu không xác định là 0"

#: includes/settings.php thold.php thold_templates.php
msgid "Syslog Settings"
msgstr "Cài đặt Syslog"

#: includes/settings.php
msgid "Syslog Enabled"
msgstr "Đã bật Syslog"

#: includes/settings.php
msgid "If checked, when creating a new Threshold, by default new Threshold events will be sent to your local syslog.  This setting is a preset.  Threshold settings dictate actual syslog control."
msgstr "Nếu được chọn, khi tạo Ngưỡng mới, theo mặc định, các sự kiện Ngưỡng mới sẽ được gửi đến nhật ký hệ thống cục bộ của bạn. Cài đặt này là một cài đặt trước. Cài đặt ngưỡng cho phép điều khiển nhật ký hệ thống thực tế."

#: includes/settings.php
msgid "Default Priority/Level"
msgstr "Mức độ ưu tiên / mức độ mặc định"

#: includes/settings.php
msgid "This is the default Priority/Level that Thold will use to send syslog messages.  This setting is a preset.  Threshold settings dictate actual syslog control."
msgstr "Đây là Mức ưu tiên / Mức mặc định mà Thold sẽ sử dụng để gửi tin nhắn nhật ký hệ thống. Cài đặt này là một cài đặt trước. Cài đặt ngưỡng cho phép điều khiển nhật ký hệ thống thực tế."

#: includes/settings.php
msgid "Default Facility"
msgstr "Cơ sở mặc định"

#: includes/settings.php
msgid "This is the default Facility that Thold will use to send syslog messages.  This setting is a preset.  Threshold settings dictate actual syslog control."
msgstr "Đây là Cơ sở mặc định mà Thold sẽ sử dụng để gửi tin nhắn nhật ký hệ thống. Cài đặt này là một cài đặt trước. Cài đặt ngưỡng cho phép điều khiển nhật ký hệ thống thực tế."

#: includes/settings.php
msgid "Alert Presets"
msgstr "Cài đặt trước cảnh báo"

#: includes/settings.php
msgid "Weekend exemptions"
msgstr "Miễn cuối tuần"

#: includes/settings.php
msgid "If this is checked, Thold will not run on weekends."
msgstr "Nếu điều này được kiểm tra, Thold sẽ không chạy vào cuối tuần."

#: includes/settings.php
msgid "Default Trigger Count"
msgstr "Số lượng kích hoạt mặc định"

#: includes/settings.php
msgid "Default number of consecutive times the Data Source must be in breach of the Threshold for an Alert to be raised."
msgstr "Số lần mặc định liên tiếp Nguồn dữ liệu phải vi phạm Ngưỡng để cảnh báo được đưa ra."

#: includes/settings.php
msgid "Re-Alerting"
msgstr "Cảnh báo lại"

#: includes/settings.php
msgid "Repeat Alert after specified number of poller cycles."
msgstr "Lặp lại cảnh báo sau khi xác định số chu kỳ pug."

#: includes/settings.php
msgid "Baseline Presets"
msgstr "Đặt trước đường cơ sở"

#: includes/settings.php
msgid "Baseline Time Range Default"
msgstr "Đường cơ sở thời gian mặc định"

#: includes/settings.php
msgid "This is the default value used in creating Thresholds or templates."
msgstr "Đây là giá trị mặc định được sử dụng trong việc tạo Ngưỡng hoặc mẫu."

#: includes/settings.php
msgid "Baseline Trigger Count"
msgstr "Số lượng kích hoạt cơ bản"

#: includes/settings.php
msgid "Default number of consecutive times the Data Source must be in breach of the calculated Baseline Threshold for an Alert to be raised."
msgstr "Số lần mặc định liên tiếp Nguồn dữ liệu phải vi phạm Ngưỡng cơ sở được tính toán để Cảnh báo được đưa ra."

#: includes/settings.php
