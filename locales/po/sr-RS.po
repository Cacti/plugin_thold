msgid "You must specify either 'High Alert Threshold' or 'Low Alert Threshold' or both!"
msgstr "Морате навести или 'Горњи праг аларма' или 'Доњи праг аларма' или оба!"

#: includes/functions.php
msgid "Impossible threshold: 'High Alert Threshold' smaller than the 'Low Alert Threshold'!"
msgstr "Немогућ праг: 'Горњи праг аларма' је мањи од 'Доњег прага аларма'!"

#: includes/functions.php
msgid "Impossible threshold: 'High Warning Threshold' smaller than the 'Low Warning Threshold'!"
msgstr "Немогућ праг: 'Горњи праг упозорења' је мањи од 'Доњег прага упозорења'!"

#: includes/functions.php
msgid "Impossible threshold: 'High Warning Threshold' larger than the 'High Alert Threshold'!"
msgstr "Немогућ праг: 'Горњи праг упозорења' је већи од 'Горњег прага аларма'!"

#: includes/functions.php
msgid "Impossible threshold: 'Low Alert Threshold' larger than the 'Low Warning Threshold'!"
msgstr "Немогућ праг: 'Доњи праг аларма' је већи од 'Доњег прага упозорења'!"

#: includes/functions.php
msgid "Time reference in the past must be set to positive integer value!"
msgstr "Временска референца у прошлости мора бити постављена на позитивну целобројну вредност!"

#: includes/functions.php
msgid "You must specify either 'Baseline Deviation UP' or 'Baseline Deviation DOWN' or both!"
msgstr "Морате навести или 'Одступање од основне линије НАГОРЕ' или 'Одступање од основне линије НАДОЛЕ' или оба!"

#: includes/functions.php
msgid "Impossible threshold: 'High Alert Threshold' smaller than the 'Low Alert Threshold'"
msgstr "Немогућ праг: 'Горњи праг аларма' је мањи од 'Доњег прага аларма'"

#: includes/functions.php
msgid "Impossible threshold: The Alert Trigger Count must be greater or eval to 1!"
msgstr "Немогућ праг: Број окидача аларма мора бити већи или једнак 1!"

#: includes/functions.php
msgid "Impossible threshold: The Alert Trigger Count must be less than or equal to the Trigger Count or eval to 1!"
msgstr "Немогућ праг: Број окидача аларма мора бити мањи или једнак броју окидача или једнак 1!"

#: includes/functions.php
msgid "Impossible threshold: The Warning Trigger Count must be greater or eval to 1!"
msgstr "Немогућ праг: Број окидача упозорења мора бити већи или једнак 1!"

#: includes/functions.php
msgid "Impossible threshold: The Warning Trigger Count must be less than or equal to the Trigger Count or eval to 1!"
msgstr "Немогућ праг: Број окидача упозорења мора бити мањи или једнак броју окидача или једнак 1!"

#: includes/functions.php
msgid "Impossible threshold: 'Low Warning Threshold' smaller than the 'Low Alert Threshold'!"
msgstr "Немогућ праг: 'Доњи праг упозорења' је мањи од 'Доњег прага аларма'!"

