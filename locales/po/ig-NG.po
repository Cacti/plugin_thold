msgstr "Gbanye ndekọ nke ọdịda Ọnụ ụzọ niile na Ndekọ Cacti."

#: includes/settings.php
msgid "Show Data Source in Log"
msgstr "Gosi Isi Iyi Data na Ndekọ"

