msgstr "Mgbe ị na-agbakọ Ọnụ ụzọ Okwu (Expression Thresholds), ọ bụrụ na ifHighSpeed na ifSpeed lọghachiri dị ka efu, jiri ntọala ifHighSpeed na-esonụ kama. ifHighSpeed ndabara ga-abụ 10000 maka njikọ 10GE."

#: includes/settings.php
msgid "Notification Preferences"
msgstr "Mmasị Ọkwa"

#: includes/settings.php
msgid "Disable Legacy Notifications"
msgstr "Gbanyụọ Ọkwa Ochie"

#: includes/settings.php
msgid "Checking this box will disable Legacy Alerting on all Thresholds.  Legacy Alerting is defined as any Specific Email Alerts not associated with a Notification List."
msgstr "Ịkaa akara n'igbe a ga-agbanyụ Ịma Mkpu Ochie n'Ọnụ ụzọ niile. A na-akọwa Ịma Mkpu Ochie dị ka Mkpu Ozi-e Pụrụ Iche ọ bụla na-ejikọghị na Ndepụta Ọkwa."

#: includes/settings.php
msgid "Threshold Notification Templated"
msgstr "Ọkwa Ọnụ ụzọ Nwere Nlereanya"

#: includes/settings.php
msgid "If checked, when creating at Threshold Template, its Notification Settings will, by default be owned by the Threshold Template."
msgstr "Ọ bụrụ na a kaa ya akara, mgbe a na-eke Nlereanya Ọnụ ụzọ, Ntọala Ọkwa ya ga-abụ nke Nlereanya Ọnụ ụzọ nwe site na ndabara."

#: includes/settings.php
msgid "Enable Command Execution"
msgstr "Gbanye Mmezu Iwu"

#: includes/settings.php
msgid "Checking this box will enable the ability to run commands on Threshold breach and restoral events."
msgstr "Ịkaa akara n'igbe a ga-agbanye ikike ịgba iwu na mmebi Ọnụ ụzọ na ihe omume mweghachi."

#: includes/settings.php
msgid "Enable Per Thold Notification"
msgstr "Gbanye Ọkwa Maka Thold Ọ bụla"

#: includes/settings.php
msgid "Checking this box will enable the ability to maintain custom Email bodies for Thresholds."
msgstr "Ịkaa akara n'igbe a ga-agbanye ikike idobe ahụ Ozi-e ahaziri maka Ọnụ ụzọ Gasị."

#: includes/settings.php
msgid "Enable Notification Queue"
msgstr "Gbanye Ahịrị Ọkwa"

#: includes/settings.php
msgid "Checking this box will switch Thold from performing inline Notification to using either the Notification Daemon, or notifications performed out of band by the Notification poller."
msgstr "Ịkaa akara n'igbe a ga-atụgharị Thold site n'ime Ọkwa n'ahịrị gaa n'iji Notification Daemon, ma ọ bụ ọkwa nke Notification poller na-eme n'èzí."

#: includes/settings.php
msgid "Enable Sending Alert Emails to Warning Notification Lists"
msgstr "Gbanye Izipu Ozi-e Mkpọku na Ndepụta Ọkwa Ịdọ aka ná ntị"

#: includes/settings.php
msgid "Check this box if you wish Warning Notification List recipients to receive Alert Emails in addition to the Alert Notification list receivers.  This case is applicable when Warning Notifications goes to Administrators and Alert Notifications go to Management."
msgstr "Kaa akara n'igbe a ma ọ bụrụ na ịchọrọ ka ndị na-anata Ndepụta Ọkwa Ịdọ aka ná ntị nata Ozi-e Mkpu tinyere ndị na-anata ndepụta Ọkwa Mkpu. Ọnọdụ a na-adị ire mgbe Ọkwa Ịdọ aka ná ntị na-agara Ndị Nchịkwa ma Ọkwa Mkpu na-agara Ndị Isi."

#: includes/settings.php
msgid "Threshold Daemon"
msgstr "Daemon Ọnụ ụzọ"

#: includes/settings.php
msgid "Enable Threshold Daemon"
msgstr "Gbanye Daemon Ọnụ ụzọ"

#: includes/settings.php
msgid "Checking this box will enable the use of a dedicated Threshold daemon. This can be used to increase system performance and/or to distribute Threshold monitoring to a separate server."
msgstr "Ịkaa akara n'igbe a ga-agbanye iji daemon Ọnụ ụzọ raara onwe ya nye. Enwere ike iji nke a mee ka arụmọrụ sistemụ dịkwuo elu na/ma ọ bụ kesaa nleba anya Ọnụ ụzọ na sava dị iche."

#: includes/settings.php
msgid "Force Threshold Daemon Debug"
msgstr "Manye Nchọpụta Mperi Daemon Ọnụ ụzọ"

#: includes/settings.php
msgid "Checking this box will enable Threshold Daemon debug when operating from SystemD or through the command line.  This change is dynamic and will take effect as soon as the next Threshold loop commences."
msgstr "Ịkaa akara n'igbe a ga-agbanye nchọpụta njehie Threshold Daemon mgbe ọ na-arụ ọrụ site na SystemD ma ọ bụ site n'ahịrị iwu. Mgbanwe a na-adị ngwa ma ga-amalite ozugbo okirikiri Ọnụ ụzọ na-esote malitere."

#: includes/settings.php
msgid "Daemon Down Notification Frequency"
msgstr "Ugboro Ọkwa Mgbe Daemon Dara"

#: includes/settings.php
msgid "If the Thold Daemon is found to be down, send out an Email notification at this frequency."
msgstr "Ọ bụrụ na achọpụta na Thold Daemon adịghị arụ ọrụ, zipụ ọkwa Ozi-e n'oge ugboro ugboro a."

