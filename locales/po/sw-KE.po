#: includes/functions.php
msgid "Impossible threshold: 'High Alert Threshold' smaller than the 'Low Alert Threshold'"
msgstr "Kizingiti kisichowezekana: 'Kizingiti cha Tahadhari ya Juu' ni kidogo kuliko 'Kizingiti cha Tahadhari ya Chini'"

#: includes/functions.php
msgid "Impossible threshold: The Alert Trigger Count must be greater or eval to 1!"
msgstr "Kizingiti kisichowezekana: Idadi ya Vichochezi vya Tahadhari lazima iwe kubwa au sawa na 1!"

#: includes/functions.php
msgid "Impossible threshold: The Alert Trigger Count must be less than or equal to the Trigger Count or eval to 1!"
msgstr "Kizingiti kisichowezekana: Idadi ya Vichochezi vya Tahadhari lazima iwe chini au sawa na Idadi ya Vichochezi au sawa na 1!"

#: includes/functions.php
msgid "Impossible threshold: The Warning Trigger Count must be greater or eval to 1!"
msgstr "Kizingiti kisichowezekana: Idadi ya Vichochezi vya Onyo lazima iwe kubwa au sawa na 1!"

#: includes/functions.php
msgid "Impossible threshold: The Warning Trigger Count must be less than or equal to the Trigger Count or eval to 1!"
msgstr "Kizingiti kisichowezekana: Idadi ya Vichochezi vya Onyo lazima iwe chini au sawa na Idadi ya Vichochezi au sawa na 1!"

#: includes/functions.php
msgid "Impossible threshold: 'Low Warning Threshold' smaller than the 'Low Alert Threshold'!"
msgstr "Kizingiti kisichowezekana: 'Kizingiti cha Onyo la Chini' ni kidogo kuliko 'Kizingiti cha Tahadhari ya Chini'!"

